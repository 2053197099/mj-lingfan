{
  "manifest_version": 3,
  "name": "MJ 灵帆",
  "description": "Midjourney 网页端轻量助手：批量队列、随机间隔发送、尺寸选择、变量、提示词翻译与图片下载。",
  "version": "1.0.29",
  "permissions": ["alarms", "downloads", "storage"],
  "host_permissions": [
    "https://www.midjourney.com/*",
    "https://midjourney.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.midjourney.com/*",
        "https://midjourney.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png",
        "docs/images/panel-overview.svg",
        "docs/images/command-rules.svg",
        "docs/images/variable-flow.svg"
      ],
      "matches": [
        "https://www.midjourney.com/*",
        "https://midjourney.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "MJ 灵帆",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
